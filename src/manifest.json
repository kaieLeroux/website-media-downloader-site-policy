{
    "name": "Website Media Downloader — Site Policy",
    "manifest_version": 3,
    "version": "2.3.2.1",
    "description": "__MSG_extensionDescription__",
    "author": "anpa26",
    "developer": {
        "name": "anpa26",
        "url": "https://github.com/anpa26"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "website-media-downloader-site-policy@local.invalid",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "downloads",
        "notifications",
        "tabs",
        "activeTab",
        "webRequest",
        "webRequestBlocking",
        "webRequestFilterResponse",
        "scripting",
        "offscreen",
        "identity"
    ],
    "oauth2": {
        "client_id": "1042907477337-c8h27qniercjia05jqqafgvjao514n28.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.file"
        ]
    },
    "optional_permissions": [],
    "host_permissions": [
        "<all_urls>"
    ],
    "homepage_url": "https://github.com/anpa26/website-media-downloader",
    "background": {
        "service_worker": "network_detector.js",
        "scripts": [
            "libraries/wymd.js",
            "site_policy.js",
            "auto_archive.js",
            "stream_jobs.js",
            "network_detector.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "*://media.example.org/works/*"
            ],
            "css": [
                "styles/content-toast.css"
            ],
            "js": [
                "surgical_scrapers.js",
                "offlineStreamConvert.js",
                "content_detector.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.youtube.com/embed/*"
            ],
            "js": [
                "libraries/wymd.js",
                "yt_core.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "exclude_matches": [
                "*://*.youtube.com/embed/*"
            ],
            "js": [
                "libraries/wymd.js",
                "yt_core.js"
            ],
            "run_at": "document_end",
            "all_frames": false
        }
    ],
    "icons": {
        "96": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "action": {
        "default_title": "__MSG_actionTitle__"
    },
    "default_locale": "en",
    "options_page": "popup.html?options=true"
}
