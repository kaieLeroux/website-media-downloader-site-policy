{
    "name": "Website Media Downloader",
    "manifest_version": 3,
    "version": "2.0.5",
    "description": "__MSG_extensionDescription__",
    "author": "anpa26",
    "developer": {
        "name": "anpa26",
        "url": "https://github.com/anpa26"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "{924f7c81-8b1e-4b6e-9e7c-8e4a9e1d2c3f}",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "downloads",
        "notifications",
        "tabs",
        "activeTab",
        "webRequest",
        "webRequestBlocking",
        "webRequestFilterResponse",
        "scripting",
        "offscreen",
        "identity"
    ],
    "oauth2": {
        "client_id": "1042907477337-c8h27qniercjia05jqqafgvjao514n28.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.file"
        ]
    },
    "optional_permissions": [],
    "host_permissions": [
        "<all_urls>"
    ],
    "homepage_url": "https://github.com/anpa26/website-media-downloader",
    "background": {
        "service_worker": "network_detector.js",
        "scripts": [
            "libraries/client-zip.js",
            "network_detector.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "surgical_scrapers.js",
                "content_detector.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "yt_core.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "yt_page.js"
            ],
            "run_at": "document_end",
            "world": "MAIN",
            "all_frames": true
        }
    ],
    "icons": {
        "96": "icons/icon.svg",
        "128": "icons/icon.svg"
    },
    "action": {
        "default_title": "__MSG_actionTitle__"
    },
    "default_locale": "en",
    "options_page": "popup.html?options=true"
}
